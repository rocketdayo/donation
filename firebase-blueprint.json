{
  "entities": {
    "TicketRecord": {
      "title": "TicketRecord",
      "description": "Blood donation ticket record with attendee info and queue state",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ticket document ID",
          "maxLength": 128
        },
        "ticketNumber": {
          "type": "number",
          "description": "Sequential ticket queue number"
        },
        "name": {
          "type": "string",
          "description": "Attendee full name",
          "maxLength": 100
        },
        "kana": {
          "type": "string",
          "description": "Attendee kana name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Attendee contact email",
          "maxLength": 200
        },
        "timeSlot": {
          "type": "string",
          "description": "Reserved time slot",
          "maxLength": 50
        },
        "scheduledDate": {
          "type": "string",
          "description": "Scheduled date",
          "maxLength": 50
        },
        "attendance": {
          "type": "string",
          "enum": ["unattended", "present", "absent", "completed"],
          "description": "Attendance status"
        },
        "queueStatus": {
          "type": "string",
          "enum": ["waiting", "called", "on_hold", "interview", "donating", "resting", "done", "absent"],
          "description": "Current queue status"
        },
        "bloodType": {
          "type": "string",
          "maxLength": 20
        },
        "donationType": {
          "type": "string",
          "maxLength": 50
        },
        "firstTimeDonor": {
          "type": "boolean"
        },
        "registeredAt": {
          "type": "string",
          "maxLength": 50
        },
        "arrivedAt": {
          "type": "string",
          "maxLength": 50
        },
        "calledAt": {
          "type": "string",
          "maxLength": 50
        },
        "completedAt": {
          "type": "string",
          "maxLength": 50
        },
        "lotteryResult": {
          "type": "string",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["id", "ticketNumber", "name", "email", "timeSlot", "attendance", "queueStatus"]
    },
    "AdminAuthConfig": {
      "title": "AdminAuthConfig",
      "description": "Hashed password and cryptographic salt for admin dashboard authentication",
      "type": "object",
      "properties": {
        "salt": {
          "type": "string",
          "description": "Cryptographic salt hex string"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 hashed password with salt"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last password update"
        }
      },
      "required": ["salt", "hash", "updatedAt"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": {
        "$ref": "#/entities/TicketRecord"
      },
      "description": "Collection of all blood donation queue tickets and schedules"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/AdminAuthConfig"
      },
      "description": "Configuration settings and hashed authentication data"
    }
  }
}
